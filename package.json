{
  "name": "partyficrim",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:shared": "npm --workspace=shared run dev",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "npm --workspace=shared run build && npm-run-all --parallel dev:shared dev:server dev:client",
    "test": "npm --workspaces --if-present run test",
    "test:e2e": "npx playwright test",
    "build": "npm --workspaces --if-present run build",
    "format": "prettier --write \"{client,server,shared}/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
